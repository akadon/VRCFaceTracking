<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VRCFaceTracking.Linux.ViewModels"
        x:Class="VRCFaceTracking.Linux.Views.MainWindow"
        Title="VRCFaceTracking"
        Width="900" Height="600"
        MinWidth="600" MinHeight="400">

  <Grid ColumnDefinitions="200,*">

    <!-- Left sidebar -->
    <Border Grid.Column="0" Background="#1E1E2E" Padding="0,8">
      <StackPanel Spacing="0">
        <StackPanel Margin="16,8,16,16" Spacing="4">
          <TextBlock Text="VRCFaceTracking" FontSize="14" FontWeight="Bold"
                     Foreground="White" />
          <TextBlock Text="{Binding StatusText}" FontSize="11"
                     Foreground="#A0A0C0" />
        </StackPanel>

        <Button Name="BtnHome" Classes="nav" Content="  Home" Click="NavHome_Click" />
        <Button Name="BtnRegistry" Classes="nav" Content="  Module Registry" Click="NavRegistry_Click" />
        <Button Name="BtnModules" Classes="nav" Content="  Loaded Modules" Click="NavModules_Click" />
        <Button Name="BtnOutput" Classes="nav" Content="  Output" Click="NavOutput_Click" />
        <Button Name="BtnSettings" Classes="nav" Content="  Settings" Click="NavSettings_Click" />

        <!-- OSC stats at bottom -->
        <StackPanel Margin="16,32,16,8" Spacing="4">
          <TextBlock Text="OSC" FontSize="11" FontWeight="SemiBold"
                     Foreground="#A0A0C0" />
          <TextBlock FontSize="11" Foreground="#80C0A0">
            <Run Text="In: " />
            <Run Text="{Binding MessagesInPerSec}" />
            <Run Text=" msg/s" />
          </TextBlock>
          <TextBlock FontSize="11" Foreground="#80A0C0">
            <Run Text="Out: " />
            <Run Text="{Binding MessagesOutPerSec}" />
            <Run Text=" msg/s" />
          </TextBlock>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Right content area -->
    <ContentControl Grid.Column="1" Name="ContentArea" />

  </Grid>
</Window>
