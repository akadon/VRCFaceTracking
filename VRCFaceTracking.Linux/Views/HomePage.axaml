<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VRCFaceTracking.Linux.ViewModels"
             x:Class="VRCFaceTracking.Linux.Views.HomePage">

  <ScrollViewer Padding="24">
    <StackPanel Spacing="16">

      <TextBlock Text="Dashboard" FontSize="22" FontWeight="Bold" />

      <!-- Status card -->
      <Border Classes="card" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="Status" FontSize="14" FontWeight="SemiBold" />
          <TextBlock Text="{Binding StatusText}" FontSize="13" />
          <TextBlock IsVisible="{Binding NoModulesInstalled}"
                     Text="No face tracking modules installed. Add modules to ~/.config/VRCFaceTracking/CustomLibs/"
                     Foreground="Orange" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- OSC target card -->
      <Border Classes="card" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="OSC Target" FontSize="14" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" >
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Address: " FontSize="12" Foreground="#A0A0C0" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OscTarget.DestinationAddress}" FontSize="12" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Port: " FontSize="12" Foreground="#A0A0C0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OscTarget.OutPort}" FontSize="12" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Loaded modules -->
      <Border Classes="card" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="Loaded Modules" FontSize="14" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding LibManager.LoadedModulesMetadata}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="8,6" Margin="0,2" Background="#2A2A3E" CornerRadius="4">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock FontSize="11" Foreground="#80C080">
                          <Run Text="Eye: " />
                          <Run Text="{Binding SupportsEye}" />
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="#80C0C0">
                          <Run Text="Face: " />
                          <Run Text="{Binding SupportsExpression}" />
                        </TextBlock>
                      </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center"
                               Foreground="#A0A0C0" Text="{Binding ModuleState}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
