<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VRCFaceTracking.Linux.Views.OutputPage">

  <Grid RowDefinitions="Auto,*" Margin="24,16,24,24">
    <TextBlock Grid.Row="0" Text="Output Log" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />
    <Border Grid.Row="1" Classes="card" Padding="0">
      <ScrollViewer Name="LogScroller">
        <ItemsControl Name="LogItems" ItemsSource="{Binding LogLines}" Padding="12">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" FontFamily="Monospace" FontSize="11"
                         TextWrapping="NoWrap" Foreground="#C0C0D0" Margin="0,1" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
