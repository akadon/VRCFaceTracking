<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VRCFaceTracking.Linux.ViewModels"
             x:Class="VRCFaceTracking.Linux.Views.CalibrationPage"
             x:DataType="vm:CalibrationViewModel">

  <UserControl.Resources>

    <!-- Action button -->
    <DataTemplate x:Key="ActionTpl" DataType="vm:MutationActionViewModel">
      <Border Background="#14ffffff" CornerRadius="4" Padding="12,8" Margin="0,2">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding Name}"
                     VerticalAlignment="Center" FontSize="12" Foreground="#C0C0D8" />
          <Button Grid.Column="1" Content="{Binding Name}"
                  Command="{Binding ExecuteCommand}"
                  Padding="10,4" FontSize="11"
                  Background="#2A3A5A" Foreground="#80B0E0"
                  CornerRadius="4" BorderThickness="0" />
        </Grid>
      </Border>
    </DataTemplate>

    <!-- Range (two sliders) -->
    <DataTemplate x:Key="RangeTpl" DataType="vm:MutationRangeViewModel">
      <Border Background="#14ffffff" CornerRadius="4" Padding="12,8" Margin="0,2">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#C0C0D8" />
          <Grid ColumnDefinitions="64,*,64">
            <NumericUpDown Grid.Column="0"
                           Value="{Binding RangeStart, Mode=TwoWay}"
                           Minimum="{Binding Min}" Maximum="{Binding Max}"
                           Increment="0.01" FormatString="0.00"
                           FontSize="11" Padding="4,2" />
            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Spacing="2">
              <Slider Value="{Binding RangeStart, Mode=TwoWay}"
                      Minimum="{Binding Min}" Maximum="{Binding Max}"
                      TickPlacement="None" />
              <Slider Value="{Binding RangeEnd, Mode=TwoWay}"
                      Minimum="{Binding Min}" Maximum="{Binding Max}"
                      TickPlacement="None" />
            </StackPanel>
            <NumericUpDown Grid.Column="2"
                           Value="{Binding RangeEnd, Mode=TwoWay}"
                           Minimum="{Binding Min}" Maximum="{Binding Max}"
                           Increment="0.01" FormatString="0.00"
                           FontSize="11" Padding="4,2" />
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Property: CheckBox / Slider / TextBox based on Type enum -->
    <DataTemplate x:Key="PropertyTpl" DataType="vm:MutationPropertyViewModel">
      <Border Background="#14ffffff" CornerRadius="4" Padding="12,8" Margin="0,2">
        <Grid>
          <!-- CheckBox row -->
          <Grid ColumnDefinitions="*,Auto"
                IsVisible="{Binding Type,
                  Converter={x:Static ObjectConverters.Equal},
                  ConverterParameter={x:Static vm:MutationPropertyTypeProxy.CheckBox}}">
            <TextBlock Grid.Column="0" Text="{Binding Name}"
                       VerticalAlignment="Center" FontSize="12" Foreground="#C0C0D8" />
            <CheckBox Grid.Column="1" IsChecked="{Binding BoolValue, Mode=TwoWay}"
                      HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
          <!-- Slider row -->
          <Grid ColumnDefinitions="*,60,160"
                IsVisible="{Binding Type,
                  Converter={x:Static ObjectConverters.Equal},
                  ConverterParameter={x:Static vm:MutationPropertyTypeProxy.Slider}}">
            <TextBlock Grid.Column="0" Text="{Binding Name}"
                       VerticalAlignment="Center" FontSize="12" Foreground="#C0C0D8" />
            <NumericUpDown Grid.Column="1"
                           Value="{Binding FloatValue, Mode=TwoWay}"
                           Minimum="{Binding Min}" Maximum="{Binding Max}"
                           Increment="0.01" FormatString="0.00"
                           FontSize="10" Padding="2" ShowButtonSpinner="False" />
            <Slider Grid.Column="2"
                    Value="{Binding FloatValue, Mode=TwoWay}"
                    Minimum="{Binding Min}" Maximum="{Binding Max}"
                    TickPlacement="None" VerticalAlignment="Center" />
          </Grid>
          <!-- TextBox row -->
          <Grid ColumnDefinitions="*,180"
                IsVisible="{Binding Type,
                  Converter={x:Static ObjectConverters.Equal},
                  ConverterParameter={x:Static vm:MutationPropertyTypeProxy.TextBox}}">
            <TextBlock Grid.Column="0" Text="{Binding Name}"
                       VerticalAlignment="Center" FontSize="12" Foreground="#C0C0D8" />
            <TextBox Grid.Column="1" Text="{Binding StringValue, Mode=TwoWay}"
                     FontSize="11" VerticalAlignment="Center" />
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>

  </UserControl.Resources>

  <ScrollViewer Padding="24,16,24,24">
    <StackPanel Spacing="8">
      <TextBlock Text="Calibration" FontSize="22" FontWeight="Bold" Margin="0,0,0,4" />
      <TextBlock Text="Configure tracking mutations and continuous calibration."
                 FontSize="12" Foreground="#A0A0C0" Margin="0,0,0,8" />

      <ItemsControl ItemsSource="{Binding Mutations}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:MutationViewModel">
            <!-- IsActive sits outside the Expander so clicks aren't swallowed
                 by the Expander's internal ToggleButton. -->
            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,4">
              <CheckBox Grid.Column="0"
                        IsChecked="{Binding IsActive, Mode=TwoWay}"
                        VerticalAlignment="Top" Margin="0,10,8,0" />
              <Expander Grid.Column="1" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                <Expander.Header>
                  <StackPanel Spacing="2" Margin="0,4,0,4">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" FontSize="11"
                               Foreground="#A0A0C0" TextWrapping="Wrap" />
                  </StackPanel>
                </Expander.Header>

                <ItemsControl ItemsSource="{Binding Components}" Margin="8,4,0,8">
                  <ItemsControl.DataTemplates>
                    <DataTemplate DataType="vm:MutationActionViewModel">
                      <ContentControl Content="{Binding}"
                                      ContentTemplate="{StaticResource ActionTpl}" />
                    </DataTemplate>
                    <DataTemplate DataType="vm:MutationRangeViewModel">
                      <ContentControl Content="{Binding}"
                                      ContentTemplate="{StaticResource RangeTpl}" />
                    </DataTemplate>
                    <DataTemplate DataType="vm:MutationPropertyViewModel">
                      <ContentControl Content="{Binding}"
                                      ContentTemplate="{StaticResource PropertyTpl}" />
                    </DataTemplate>
                  </ItemsControl.DataTemplates>
                </ItemsControl>

              </Expander>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
